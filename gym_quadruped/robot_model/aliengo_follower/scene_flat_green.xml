<mujoco model="aliengo scene">
<include file="new_urdf_export.xml"/>


  
  
  <!-- <include file="aliengo_arm_follower.xml"/>  -->

  <statistic center="0 0 0.1" extent="0.8"/>
  


    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0 0 0 0"/>
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <asset>
        <texture
                type="skybox"
                builtin="gradient"
                rgb1="0.99 0.99 0.99"
                rgb2="0.99 0.99 0.99"
                width="512"
                height="3072"
        />
        <texture
                type="2d"
                name="groundplane"
                builtin="checker"
                mark="edge"
                rgb1="0.93 0.93 0.93"
                rgb2="1.0 1.0 1.0"
                markrgb="1 1 1"
                width="200"
                height="200"
        />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.05"/>
    </asset>




  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.1" type="plane" rgba="0 1 0 1"/>

    <body name="reference" pos="0.557 0 0.458" quat="1.0 0 0 0" mocap="true">
    <site name="reference_site" pos="0 0 0" size="0.02" rgba="1.0 0.0 0.0 0.0"/>
    <geom name="box" type="box" size="0.02 0.02 0.02" rgba="1.0 0. 0. 0.0" contype="0" conaffinity="0"/>
    </body>
    <!-- <geom pos="1.1 0.0 0.025" type="box" size="0.05 1.25 0.025" quat="1.0 0.0 0.0 0.0" /> -->
        <!-- <geom pos="2 0.0 0.32499999999999996" type="box" size="10 2 0.025" quat="1.0 0.0 -0.1 0.0" rgba="0.2 0.2 0.2 1"  contype="1" conaffinity="0"/> -->

  </worldbody>

    <actuator>       
        
        <motor name="follower/FL_hip"   class="follower/hip"    gear="1" joint="follower/FL_hip_joint"/>
        <motor name="follower/FL_thigh" class="follower/thigh"  gear="1" joint="follower/FL_thigh_joint"/>
        <motor name="follower/FL_calf"  class="follower/calf"   gear="1" joint="follower/FL_calf_joint"/>
        <motor name="follower/FR_hip"   class="follower/hip"    gear="1" joint="follower/FR_hip_joint"/>
        <motor name="follower/FR_thigh" class="follower/thigh"  gear="1" joint="follower/FR_thigh_joint"/>
        <motor name="follower/FR_calf"  class="follower/calf"   gear="1" joint="follower/FR_calf_joint"/>
       
        <motor name="follower/RL_hip"   class="follower/hip"    gear="1" joint="follower/RL_hip_joint"/>
        <motor name="follower/RL_thigh" class="follower/thigh"  gear="1" joint="follower/RL_thigh_joint"/>
        <motor name="follower/RL_calf"  class="follower/calf"   gear="1" joint="follower/RL_calf_joint"/>
         <motor name="follower/RR_hip"   class="follower/hip"    gear="1" joint="follower/RR_hip_joint"/>
        <motor name="follower/RR_thigh" class="follower/thigh"  gear="1" joint="follower/RR_thigh_joint"/>
        <motor name="follower/RR_calf"  class="follower/calf"   gear="1" joint="follower/RR_calf_joint" />
    </actuator>

    <sensor>
        <accelerometer name='imu' site="follower/imu" />
        <gyro name="follower/imu_gyro" site="follower/imu" />
    </sensor>
    
    <keyframe>
    
        <key name="home_wide" qpos="
        0. 0 0.35  
