            <motor ctrlrange="-4400.4 4400.4"/>
        </default>
        <default class="follower/thigh">
            <motor ctrlrange="-3500.278 3500.278"/>
        </default>
        <default class="follower/calf">
            <motor ctrlrange="-3500.278 3500.278"/>
        </default>
        
        <default class="follower/arm_joint_params_1">
            <joint  axis="0 0 1" limited="true" range="-1.5 1.5"   stiffness="10" damping="4.2"/>
        </default>

        <default class="follower/arm_joint_params_2">
            <joint axis="0 1 0" limited="false" range="0 1" stiffness="25" damping="10.02"/>
        </default>

        <default class="follower/arm_joint_params_3">
            <joint  stiffness="0.001" damping="4"/>
        </default>

    </default>

