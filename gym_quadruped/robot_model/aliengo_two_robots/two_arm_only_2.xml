<mujoco model="aliengo">
    <compiler angle="radian" meshdir="./assets/" autolimits="true"/>
    <option cone="elliptic" impratio="100" />
    <size njmax="500" nconmax="100" />
    <option gravity='0 0 -9.806' timestep='0.002'/>



    <default>

        <joint damping="0." armature="0.01" frictionloss="0." />
        
        <default class="leader/visual_arm">
            <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="leader/visual">
            <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="leader/collision">
            <geom group="3" rgba="0.2 0.2 0.2 0.5"/>
        </default> 

        <default class="leader/hip">
            <motor ctrlrange="-4400.4 4400.4"/>
        </default>
        <default class="leader/thigh">
            <motor ctrlrange="-3500.278 3500.278"/>
        </default>
        <default class="leader/calf">
            <motor ctrlrange="-3500.278 3500.278"/>
        </default>


        <default class="leader/arm_joint_params_1">
            <joint  axis="0 0 1" limited="true" range="-1.5 1.5"   stiffness="10" damping="4.2"/>
        </default>

        <default class="leader/arm_joint_params_2">
            <joint axis="0 1 0" limited="false" range="0 1" stiffness="25" damping="10.02"/>
        </default>

        <default class="leader/arm_joint_params_3">
            <joint axis="0 1 0" limited="false" range="0 1"  stiffness="0.01" damping="4"/>
        </default>

    </default>

    <asset>
        <mesh name="leader/trunk" file="trunk.stl" />
        <mesh name="leader/hip" file="hip.stl" />
        <mesh name="leader/thigh_mirror" file="thigh_mirror.stl" />
        <mesh name="leader/calf" file="calf.stl" />
        <mesh name="leader/thigh" file="thigh.stl" />
        <mesh name="leader/base_arm_link" file="base_arm_link.stl" />
        <mesh name="leader/arm_link_1" file="arm_link_1.stl" />
        <mesh name="leader/arm_link_2" file="arm_link_2.stl" />
        <mesh name="leader/arm_link_3" file="arm_link_3.stl" />
        
    </asset>

  <worldbody>
        <body name="leader/trunk" pos="1.8 0 0.2">
