            <joint name="leader/arm_link_2_joint" pos="0.01 0 0.0" class="leader/arm_joint_params_2"/>
            
            <geom quat="1 0 0 0" type="mesh" class="leader/visual_arm"  contype="0" conaffinity="0"  rgba="0 0 0 1" mesh="leader/arm_link_2" />
