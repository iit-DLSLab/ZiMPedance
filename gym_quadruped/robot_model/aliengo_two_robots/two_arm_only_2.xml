            <freejoint/>
            
            <!-- trunk visual mesh and collision -->
            <geom type="box" class="leader/visual"    size="0.2 0.15 0.2"   quat="1.0 0.0 0.0 0.0"/>
            <geom type="box" class="leader/collision" size="0.2 0.15 0.2"   quat="1.0 0.0 0.0 0.0"/>




    

    <geom pos="-0.15 0 0.2" quat="-3.673205103346574e-06 -0.0 0.0 0.9999999999932537" type="mesh" class="leader/visual_arm"   contype="0" conaffinity="0"  rgba="0 0 0 1" mesh="leader/base_arm_link" />


