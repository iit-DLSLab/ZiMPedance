<mujoco model="aliengo scene">

  <include file="two_arm_only.xml" />
  <include file="two_arm_only_2.xml" />
  <!-- <include file="rigid_load.xml" /> -->


  <include file="weight.xml" />
  

  <statistic center="0 0 0.1" extent="0.8"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <asset>
        <texture
                type="skybox"
                builtin="gradient"
                rgb1="0.99 0.99 0.99"
                rgb2="0.99 0.99 0.99"
                width="512"
                height="3072"/>
        <texture
                type="2d"
                name="groundplane"
                builtin="checker"
                mark="edge"
                rgb1="0.93 0.93 0.93"
                rgb2="0.93 0.93 0.93"
                markrgb="0 0 0"
                width="200"
                height="200"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
    </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
  </worldbody>
